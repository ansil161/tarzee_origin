<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0A0A0A">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- if settings.monogram_light != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.monogram_light | image_url: width: 64 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="{{ 'ze-monogram-white.png' | asset_url }}">
  {%- endif -%}
  <title>
    {{- page_title -}}
    {%- if current_tags %} &ndash; {{ 'general.search' | t }}: {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700;800&family=Marhey:wght@400;500;600&display=swap" rel="stylesheet">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <style>
    :root{
      --ink:{{ settings.color_ink | default: '#0A0A0A' }};
      --paper:{{ settings.color_paper | default: '#F4F3EF' }};
      --stone:{{ settings.color_stone | default: '#ECECE8' }};
      --ash:{{ settings.color_ash | default: '#8A8A86' }};
      --logo-w:{{ settings.logo_width | default: 120 }}px;
    }
  </style>
  <script>
    window.TERZEE = {
      smoothScroll: {{ settings.enable_smooth_scroll | json }},
      cursor: {{ settings.enable_cursor | json }},
      moneyFormat: {{ shop.money_format | json }},
      t: {
        empty: {{ 'cart.empty' | t | json }},
        remove: {{ 'cart.remove' | t | json }},
        added: "Added to bag",
        add: {{ 'products.add_to_bag' | t | json }},
        soldOut: {{ 'products.sold_out' | t | json }}
      }
    };
  </script>
  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handle }}">
  <div class="cursor" aria-hidden="true"><span class="cursor__label">View</span></div>

  <a class="visually-hidden" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'drawer-menu' %}
  {% render 'drawer-cart' %}
  <div class="toast" role="status" aria-live="polite"></div>
  <div class="lightbox" aria-hidden="true"><button class="lightbox__close" data-lightbox-close>Close {% render 'icon', name: 'close' %}</button><video controls playsinline preload="none" poster="{{ 'brand-film-poster.jpg' | asset_url }}"></video></div>
  <div class="lightbox" aria-hidden="true"><button class="lightbox__close" data-lightbox-close>Close {% render 'icon', name: 'close' %}</button><video controls playsinline preload="none" poster="{{ 'brand-film-poster.jpg' | asset_url }}"></video></div>

  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.18/dist/lenis.min.js" defer></script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
