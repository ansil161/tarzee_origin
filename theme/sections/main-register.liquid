<section class="section section--light" data-header-light>
  <div class="page-narrow">
    <h1 data-split>{{ 'customer.register' | t }}</h1>
    {%- form 'create_customer', class: 'form' -%}
      {{ form.errors | default_errors }}
      <input type="text" name="customer[first_name]" placeholder="{{ 'customer.first_name' | t }}" autocomplete="given-name">
      <input type="text" name="customer[last_name]" placeholder="{{ 'customer.last_name' | t }}" autocomplete="family-name">
      <input type="email" name="customer[email]" placeholder="{{ 'customer.email' | t }}" autocomplete="email" required>
      <input type="password" name="customer[password]" placeholder="{{ 'customer.password' | t }}" autocomplete="new-password" required>
      <button class="btn btn--solid-ink" type="submit"><span>{{ 'customer.register' | t }}</span></button>
      <a class="link" href="{{ routes.account_login_url }}">{{ 'customer.login' | t }}</a>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
