<section class="section section--light" data-header-light>
  <div class="page-narrow">
    <h1 data-split>Reset password</h1>
    {%- form 'reset_customer_password', class: 'form' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="customer[password]" placeholder="{{ 'customer.password' | t }}" required>
      <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" required>
      <button class="btn btn--solid-ink" type="submit"><span>Save</span></button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
