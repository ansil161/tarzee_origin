{%- comment -%}
  Seasonal drop — full-bleed image panel on the left (heading + pill button) and a 2 x 2 product grid
  on the right. Products come from the chosen collection; until one is chosen the demo blocks are shown.
{%- endcomment -%}
{%- liquid
  assign col = collections[section.settings.collection]
  assign use_demo = false
  if col == blank or col.products_count == 0
    assign use_demo = true
  endif
  if section.settings.image != blank
    assign panel_url = section.settings.image | image_url: width: 1400
  else
    assign panel_url = section.settings.asset | asset_url
  endif
-%}
<section class="sd" data-header-light>
  <div class="sd__panel">
    <img class="sd__bg" src="{{ panel_url }}" alt="" loading="lazy" width="1200" height="1500">
    <div class="sd__content">
      <h2 class="sd__title">{{ section.settings.heading }}</h2>
      <a class="pill pill--paper" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta }}</a>
    </div>
  </div>
  <div class="sd__grid">
    {%- if use_demo -%}
      {%- for block in section.blocks limit: 4 -%}
        <article class="sd-card" {{ block.shopify_attributes }}>
          <div class="sd-card__media">
            {%- if block.settings.tag != blank -%}<span class="sd-card__badge">{{ block.settings.tag }}</span>{%- endif -%}
            <button type="button" class="shop-wishlist" data-wishlist="{{ block.settings.title | handle }}" aria-label="Add to wishlist" aria-pressed="false"><svg class="shop-heart" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3 5.5 6.3 5.2c1.9-.2 3.6.8 4.7 2.3 1.1-1.5 2.8-2.5 4.7-2.3 3.3.3 5.1 3.4 3.8 6.6C19.5 16.4 12 21 12 21z"/></svg></button>
            <a class="sd-card__link" href="{{ block.settings.url | default: '#' }}" aria-label="{{ block.settings.title | escape }}">
              {%- if block.settings.image_alt != blank -%}<img class="alt" src="{{ block.settings.image_alt | asset_url }}" alt="" loading="lazy" width="900" height="1125">{%- endif -%}
              <img class="main" src="{{ block.settings.image | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="900" height="1125">
            </a>
          </div>
          <div class="sd-card__info">
            <a class="sd-card__title" href="{{ block.settings.url | default: '#' }}">{{ block.settings.title }}</a>
            <div class="sd-card__price">{{ block.settings.price }}{% if block.settings.compare != blank %} <s>{{ block.settings.compare }}</s>{% endif %}</div>
            <span class="sd-card__swatch" aria-hidden="true" title="Black"></span>
          </div>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- for product in col.products limit: 4 -%}
        {%- assign img1 = product.featured_image -%}
        {%- comment -%}Hover image: first gallery image whose alt text says model / wearing / worn. No match = no hover image.{%- endcomment -%}{%- assign img2 = nil -%}{%- for im in product.images offset: 1 -%}{%- assign im_alt = im.alt | downcase -%}{%- if im_alt contains 'model' or im_alt contains 'wearing' or im_alt contains 'worn' -%}{%- assign img2 = im -%}{%- break -%}{%- endif -%}{%- endfor -%}
        <article class="sd-card">
          <div class="sd-card__media">
            {%- if product.compare_at_price > product.price -%}
              {%- assign off = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
              <span class="sd-card__badge">-{{ off }}%</span>
            {%- elsif product.tags contains 'new' -%}<span class="sd-card__badge">{{ 'products.new_drop' | t }}</span>
            {%- elsif product.tags contains 'limited' -%}<span class="sd-card__badge">{{ 'products.limited' | t }}</span>{%- endif -%}
            <button type="button" class="shop-wishlist" data-wishlist="{{ product.id }}" aria-label="Add to wishlist" aria-pressed="false"><svg class="shop-heart" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3 5.5 6.3 5.2c1.9-.2 3.6.8 4.7 2.3 1.1-1.5 2.8-2.5 4.7-2.3 3.3.3 5.1 3.4 3.8 6.6C19.5 16.4 12 21 12 21z"/></svg></button>
            <a class="sd-card__link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {%- if img2 -%}<img class="alt" src="{{ img2 | image_url: width: 900 }}" alt="" loading="lazy" width="900" height="1125">{%- endif -%}
              {%- if img1 -%}<img class="main" src="{{ img1 | image_url: width: 900 }}" alt="{{ img1.alt | default: product.title | escape }}" loading="lazy" width="900" height="1125">{%- endif -%}
            </a>
          </div>
          <div class="sd-card__info">
            <a class="sd-card__title" href="{{ product.url }}">{{ product.title }}</a>
            <div class="sd-card__price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</div>
            <span class="sd-card__swatch" aria-hidden="true" title="Black"></span>
          </div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Seasonal drop",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seasonal Drop" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Shop Now" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Panel image" },
    { "type": "text", "id": "asset", "label": "Or theme asset filename", "default": "seasonal-panel.jpg" },
    { "type": "collection", "id": "collection", "label": "Collection (first 4 products; when empty the demo blocks are shown)" }
  ],
  "max_blocks": 4,
  "blocks": [
    { "type": "demo", "name": "Demo piece (asset image)", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Jaal Theory" },
      { "type": "text", "id": "price", "label": "Price", "default": "₹6,490" },
      { "type": "text", "id": "compare", "label": "Compare-at price (struck through)" },
      { "type": "text", "id": "tag", "label": "Badge (e.g. -20% or New)" },
      { "type": "text", "id": "image", "label": "Asset filename", "default": "lattice-zip-jacket-1.jpg" },
      { "type": "text", "id": "image_alt", "label": "Hover asset filename" },
      { "type": "url", "id": "url", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "Seasonal drop" } ]
}
{% endschema %}
