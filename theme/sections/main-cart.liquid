<section class="section section--tight section--light" data-header-light>
  <div class="container">
    <div class="cart-page">
      <div>
        <h1 data-split>{{ 'cart.title' | t }}</h1>
        <form action="{{ routes.cart_url }}" method="post" id="cart">
          {%- if cart.item_count == 0 -%}
            <p class="cart-empty">{{ 'cart.empty' | t }}</p>
            <a class="btn btn--ink" href="{{ routes.all_products_collection_url }}"><span>{{ 'general.continue_shopping' | t }}</span></a>
          {%- else -%}
            {%- for item in cart.items -%}
              <div class="cart-line">
                <a href="{{ item.url }}"><img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" width="120" height="150"></a>
                <div>
                  <div class="cart-line__title">{{ item.product.title }}</div>
                  <div class="cart-line__meta">{% unless item.variant.title == 'Default Title' %}{{ item.variant.title }}{% endunless %}</div>
                  <label class="visually-hidden" for="q{{ item.index }}">{{ 'cart.quantity' | t }}</label>
                  <div class="cart-line__qty" style="border-color:currentColor"><input id="q{{ item.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:60px;background:none;border:0;text-align:center;padding:8px 0"></div>
                  <a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                </div>
                <div>{{ item.final_line_price | money }}</div>
              </div>
            {%- endfor -%}
            <div class="u-mt-4"><button class="btn btn--ink" type="submit" name="update"><span>{{ 'cart.update' | t }}</span></button></div>
          {%- endif -%}
        </form>
      </div>
      {%- if cart.item_count > 0 -%}
      <aside class="cart-summary">
        <div class="cart-foot__row"><span class="t-label">{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div>
        <small style="display:block;opacity:.7;margin:10px 0 22px;font-size:12px">{{ settings.free_shipping_text }} · {{ 'cart.note' | t }}</small>
        <form action="{{ routes.cart_url }}" method="post"><button class="btn btn--solid-ink btn--wide" type="submit" name="checkout"><span>{{ 'cart.checkout' | t }}</span></button></form>
      </aside>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
