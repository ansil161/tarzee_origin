{%- if section.blocks.size > 0 -%}
<div class="ticker" role="region" aria-label="Announcement">
  <div class="ticker__track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span class="ticker__item" {{ block.shopify_attributes }}>{{ block.settings.text }}<span class="dia"></span></span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement ticker",
  "max_blocks": 6,
  "blocks": [
    { "type": "item", "name": "Message", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Free shipping across India" } ] }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "text": "Drop 01 — AW26 is live" } },
      { "type": "item", "settings": { "text": "Free shipping across India" } },
      { "type": "item", "settings": { "text": "Cut and sewn by hand · Limited runs" } }
    ]
  }
}
{% endschema %}
