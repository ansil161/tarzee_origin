{%- liquid
  assign col = collections[section.settings.collection]
  assign use_demo = false
  if col == blank or col.products_count == 0
    assign use_demo = true
  endif
-%}
<section class="section section--{{ section.settings.scheme }}" {% if section.settings.scheme != 'dark' %}data-header-light{% endif %}>
  <div class="container">
    <div class="section-head">
      <div>
        <div class="eyebrow t-label"><span class="dia"></span>{{ section.settings.eyebrow }}</div>
        <h2 class="t-display" data-split>{{ section.settings.heading }}</h2>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:14px">
        <a class="link" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">{{ section.settings.link_text }}</a>
      </div>
    </div>
    <div class="shop-grid shop-grid--home" data-stagger>
      {%- if use_demo -%}
        {%- for block in section.blocks limit: section.settings.limit -%}
          {% render 'shop-card', demo_title: block.settings.title, demo_price: block.settings.price, demo_meta: block.settings.meta, demo_image: block.settings.image, demo_url: block.settings.url, demo_tag: block.settings.tag %}
        {%- endfor -%}
      {%- else -%}
        {%- for product in col.products limit: section.settings.limit -%}
          {% render 'shop-card', product: product %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection (when empty, demo blocks below are shown)" },
    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 1, "default": 8, "label": "Pieces to show" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Shop all" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "select", "id": "scheme", "label": "Colour scheme", "default": "light", "options": [ { "value": "dark", "label": "Black" }, { "value": "light", "label": "White" }, { "value": "stone", "label": "Stone" } ] }
  ],
  "max_blocks": 12,
  "blocks": [
    { "type": "demo", "name": "Demo piece (asset image)", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Lattice Zip Jacket" },
      { "type": "text", "id": "price", "label": "Price", "default": "₹6,490" },
      { "type": "text", "id": "meta", "label": "Meta line", "default": "Jackets · Block print" },
      { "type": "text", "id": "image", "label": "Asset filename", "default": "lattice-zip-jacket-1.jpg" },
      { "type": "text", "id": "image_alt", "label": "Hover asset filename" },
      { "type": "text", "id": "tag", "label": "Tag (e.g. New drop)" },
      { "type": "url", "id": "url", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
