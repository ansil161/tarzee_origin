{%- comment -%}
  Shop the Fit — one large lookbook image under the highlights.
  Image: product metafield custom.lookbook_image, else the image set here, else the product's last photo.
{%- endcomment -%}
{%- liquid
  assign img = product.metafields.custom.lookbook_image.value | default: section.settings.image
  if img == blank and product.media.size > 2
    assign img = product.media.last
  endif
-%}
{%- if img != blank -%}
<section class="pdl">
  <h2 class="pdl__title">{{ section.settings.heading }}</h2>
  <div class="pdl__frame"><img src="{{ img | image_url: width: 1600 }}" alt="{{ product.title | escape }}" width="1251" height="1560" loading="lazy"></div>
</section>
<style>
  .pdl{background:#fff;color:#000;font-family:inherit;padding:28px 16px 8px}
  .pdl__title{margin:0 0 14px;text-align:center;font-family:inherit;font-size:22px;line-height:1.3;font-weight:400;letter-spacing:.06em;text-transform:none}
  .pdl__frame{max-width:1251px;margin:0 auto;background:#f4f4f4}
  .pdl__frame img{display:block;width:100%;height:auto;max-height:1500px;object-fit:cover}
  @media (min-width:900px){.pdl{padding:44px 50px 8px}}
</style>
{%- endif -%}
{% schema %}
{
  "name": "Product lookbook",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the Fit" },
    { "type": "image_picker", "id": "image", "label": "Lookbook image", "info": "A product metafield custom.lookbook_image overrides this per product." }
  ],
  "presets": [ { "name": "Product lookbook" } ]
}
{% endschema %}
