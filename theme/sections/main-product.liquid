{%- liquid
  assign current = product.selected_or_first_available_variant
  assign first_img = product.featured_media
  assign story_media = product.media.last
  if section.settings.pair_collection != blank
    assign pair_source = section.settings.pair_collection.products
  elsif recommendations.performed and recommendations.products_count > 0
    assign pair_source = recommendations.products
  else
    assign pair_source = collections.all.products
  endif
-%}
<section class="pdp-hero" data-pdp>
  <div class="container">
    <div class="product product--pdp">
      <div class="pdp-gallery{% if product.media.size < 2 %} no-thumbs{% endif %}" data-gallery>
        <div class="pdp-thumbs" role="group" aria-label="Product images">
          {%- if product.media.size > 1 -%}
            {%- for media in product.media limit: 3 -%}
              <button class="pdp-thumb{% if forloop.first %} is-active{% endif %}" type="button" aria-label="Show image {{ forloop.index }}"><img src="{{ media | image_url: width: 200 }}" alt="" loading="lazy" width="168" height="210"></button>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="pdp-stage" data-stage>
          {%- if current.compare_at_price > current.price -%}<span class="pdp-badge">Sale</span>{%- elsif product.metafields.custom.technique != blank -%}<span class="pdp-badge">{{ product.metafields.custom.technique }}</span>{%- endif -%}
          {%- if first_img -%}
            <img data-main src="{{ first_img | image_url: width: 1400 }}" alt="{{ first_img.alt | default: product.title | escape }}" width="1200" height="1500" fetchpriority="high">
          {%- else -%}
            <img data-main src="{{ 'lattice-zip-jacket-1.jpg' | asset_url }}" alt="" width="1200" height="1500">
          {%- endif -%}
          <button type="button" class="pdp-heart pdp-heart--stage" data-wishlist="{{ product.id }}" aria-label="Add to wishlist" aria-pressed="false"><svg class="shop-heart" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></button>
          <button class="pdp-expand" type="button" data-expand aria-label="Open full-screen gallery"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg></button>
        </div>
        <script type="application/json" data-slides>
          [{%- for media in product.media limit: 3 -%}{%- if media.media_type == 'image' -%}{"id":{{ media.id }},"src":{{ media | image_url: width: 1400 | json }},"full":{{ media | image_url: width: 2400 | json }},"alt":{{ media.alt | default: product.title | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endif -%}{%- endfor -%}]
        </script>
        {%- comment -%} Promotion + catalogue data for pdp.js. Prices in rupees. Everything is driven by this section's settings. {%- endcomment -%}
        <script type="application/json" data-pdp-data>
          {
            "promos": {
              "coupon": {% if section.settings.coupon_code != blank %}{ "code": {{ section.settings.coupon_code | json }}, "pct": {{ section.settings.coupon_pct | default: 0 }}, "min": {{ section.settings.coupon_min | default: 0 }}, "stacks": {{ section.settings.coupon_stacks | json }} }{% else %}null{% endif %},
              "prepaid_pct": {{ section.settings.prepaid_pct | default: 0 }},
              "bundle": { "duo_pct": {{ section.settings.duo_pct | default: 0 }}, "trio_pct": {{ section.settings.trio_pct | default: 0 }} },
              "free_ship_min": {{ section.settings.free_ship_min | default: 0 }},
              "ship_flat": {{ section.settings.ship_flat | default: 0 }}
            },
            "main": {
              "id": {{ current.id }}, "handle": {{ product.handle | json }}, "title": {{ product.title | json }}, "type": {{ product.type | json }},
              "tag": {{ product.metafields.custom.technique | json }}, "fabric": {{ product.metafields.custom.fabric | json }},
              "price": {{ current.price | divided_by: 100.0 }}, "compare": {{ current.compare_at_price | default: 0 | divided_by: 100.0 }},
              "img": {{ first_img | image_url: width: 800 | json }}, "url": {{ product.url | json }},
              "sizes": [{%- for v in product.variants -%}{ "id": {{ v.id }}, "title": {{ v.title | json }}, "available": {{ v.available | json }} }{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
            },
            "pairs": [
              {%- assign shown = 0 -%}
              {%- for p in pair_source -%}
                {%- if p.id != product.id and shown < 6 -%}
                  {%- assign shown = shown | plus: 1 -%}
                  {%- if shown > 1 -%},{%- endif -%}
                  {
                    "id": {{ p.selected_or_first_available_variant.id }}, "handle": {{ p.handle | json }}, "title": {{ p.title | json }}, "type": {{ p.type | json }},
                    "tag": {{ p.metafields.custom.technique | json }}, "fabric": {{ p.metafields.custom.fabric | json }},
                    "price": {{ p.price | divided_by: 100.0 }}, "compare": {{ p.compare_at_price | default: 0 | divided_by: 100.0 }},
                    "img": {{ p.featured_image | image_url: width: 600 | json }}, "url": {{ p.url | json }},
                    "sizes": [{%- for v in p.variants -%}{ "id": {{ v.id }}, "title": {{ v.title | json }}, "available": {{ v.available | json }} }{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
                  }
                {%- endif -%}
              {%- endfor -%}
            ]
          }
        </script>
      </div>

      <div class="product__info">
        <div class="product__crumb">
          <a href="{{ routes.root_url }}">Home</a> · <a href="{{ routes.all_products_collection_url }}">Drop 01</a>
          {%- if product.type != blank %} · <a href="{{ routes.collections_url }}/{{ product.type | handle }}">{{ product.type }}</a>{% endif -%}
        </div>
        <div class="pdp-brand">{{ product.vendor | default: 'Terzee Origins' }} — Drop 01</div>
        <h1 class="product__title" data-split>{{ product.title }}</h1>
        <div class="pdp-sub">{{ product.type }}{% if product.metafields.custom.technique != blank %} · {{ product.metafields.custom.technique }}{% endif %}</div>
        <div class="pdp-rating" data-rating hidden></div>

        <div class="pdp-promo" data-promo {% unless current.compare_at_price > current.price %}hidden{% endunless %}>Special price <a href="#offers">Details</a></div>
        <div class="pdp-pricebox">
          <div class="pdp-pricebox__was" data-was-row {% unless current.compare_at_price > current.price %}hidden{% endunless %}>Regular price <s data-was>{{ current.compare_at_price | money }}</s></div>
          <div class="pdp-pricebox__your"><span class="pdp-pricebox__lab">Your price</span><div class="product__price" data-price data-your-price>{{ current.price | money }}</div><span class="pdp-save" data-save hidden></span></div>
          <div class="pdp-tax">{% if shop.taxes_included %}Inclusive of all taxes{% else %}Taxes calculated at checkout{% endif %} · {{ settings.free_shipping_text }}</div>
        </div>
        <div class="pdp-best" data-bestdeal hidden><div class="pdp-best__t"><small>Best deal today</small>As low as<b data-bd-price></b><span data-bd-how></span></div><button type="button" data-unlock>Unlock my deal</button></div>

        <form method="post" action="{{ routes.cart_add_url }}" data-product-form data-pdp-form data-ajax-cart data-title="{{ product.title | escape }}" data-price="{{ current.price | divided_by: 100.0 }}" data-img="{{ first_img | image_url: width: 300 }}">
          <script type="application/json" data-variants>{{ product.variants | json }}</script>
          <input type="hidden" name="id" value="{{ current.id }}">
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="sizes" data-option>
                <div class="sizes__head"><span class="t-label">{{ option.name }}: <b data-opt-val>{{ option.selected_value }}</b></span>{% if option.name == 'Size' %}<a class="link" href="/pages/size-guide">{{ 'products.size_guide' | t }}</a>{% endif %}</div>
                <div class="sizes__grid">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign avail = false
                      for v in product.variants
                        if v.options[forloop.parentloop.index0] == value and v.available
                          assign avail = true
                        endif
                      endfor
                    -%}
                    <label>
                      <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} {% unless avail %}disabled{% endunless %}>
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
                {%- if option.name == 'Size' -%}<a class="pdp-fitlink" href="/pages/size-guide">Which size fits me?</a>{%- endif -%}
              </div>
            {%- endfor -%}
          {%- endunless -%}
          <div class="pdp-buy">
            <div class="pdp-qty"><button type="button" data-qty-step="-1" aria-label="Decrease quantity">−</button><input name="quantity" type="number" min="1" max="10" value="1" data-qty-input aria-label="Quantity" inputmode="numeric"><button type="button" data-qty-step="1" aria-label="Increase quantity">+</button></div>
            <button class="btn btn--red" type="submit" {% unless current.available %}disabled{% endunless %}><span>{% if current.available %}{{ 'products.add_to_bag' | t }}<span data-cta-price> — {{ current.price | money }}</span>{% else %}{{ 'products.sold_out' | t }}{% endif %}</span></button>
            <button class="btn btn--ghost" type="button" data-buy-now {% unless current.available %}disabled{% endunless %}><span>Buy it now</span></button>
          </div>
        </form>

        <div class="pdp-assure">
          <div><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="1"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span><b>Secure checkout.</b> Encrypted payment at checkout.</span></div>
          <div><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a1.5 1.5 0 1 0 0-.01M17 19a1.5 1.5 0 1 0 0-.01"/></svg><span><b>{{ settings.free_shipping_text }}.</b> Ships by <span data-dispatch>in 2–4 days</span></span></div>
          <div><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 3-6.2M4 4v4h4"/></svg><span><b>10-day returns.</b> Unworn, tags on.</span></div>
          <div><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20 18 6a2.5 2.5 0 1 1 2 2L6 22zM9 15l2 2"/></svg><span><b>{{ settings.tagline }}</b> Limited runs.</span></div>
        </div>

        <div class="acc" id="details">
          <details open>
            <summary>Product details<i></i></summary>
            <div class="acc__body">{%- if product.description != blank -%}<p>{{ product.description | strip_html }}</p>{%- endif -%}{{ product.metafields.custom.details | default: section.settings.details_fallback }}</div>
          </details>
          <details open>
            <summary>{{ 'products.fabric_care' | t }}<i></i></summary>
            <div class="acc__body">{{ product.metafields.custom.fabric | default: section.settings.fabric_fallback }}</div>
          </details>
          <details>
            <summary>{{ 'products.shipping_returns' | t }}<i></i></summary>
            <div class="acc__body">{{ 'products.shipping_text' | t }}</div>
          </details>
        </div>
        {%- for p in pair_source -%}
          {%- if p.id != product.id and pair_done != true -%}
            {%- assign pair_done = true -%}
            <a class="pdp-pair" href="{{ p.url }}">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 240 }}" alt="" loading="lazy" width="96" height="120">{%- endif -%}<span class="pdp-pair__t"><small>Pairs well with</small><b>{{ p.title }}</b><span>{{ p.price | money }}{% if p.compare_at_price > p.price %}<s>{{ p.compare_at_price | money }}</s>{% endif %}</span></span></a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <aside class="pdp-aside" aria-label="Others you may like">
        <h2 class="pdp-aside__h">Others you may like</h2>
        {%- assign aside_n = 0 -%}
        {%- for p in pair_source -%}
          {%- if p.id != product.id and aside_n < 3 -%}
            {%- assign aside_n = aside_n | plus: 1 -%}
            <div class="pdp-aside__i">
              <div class="pdp-aside__img"><a href="{{ p.url }}" tabindex="-1" aria-hidden="true">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 400 }}" alt="" loading="lazy" width="400" height="500">{%- endif -%}</a><button type="button" class="pdp-aside__heart" data-wishlist="{{ p.id }}" aria-label="Add to wishlist" aria-pressed="false"><svg class="shop-heart" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></button></div>
              <a class="pdp-aside__t" href="{{ p.url }}">{{ p.title }}</a>
              <span class="pdp-aside__p">{{ p.price | money }}{% if p.compare_at_price > p.price %}<s>{{ p.compare_at_price | money }}</s>{% endif %}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </aside>
    </div>
  </div>
</section>

<section class="pdp-sec pdp-sec--ivory" id="offers" data-pdp-offers data-header-light>
  <div class="container"><p class="pdp-kick" data-pdp-rise>Offers</p><h2 class="pdp-h2" data-pdp-rise>Unlock your Terzee privileges</h2><p class="pdp-lead" data-pdp-rise>Every offer that applies to this piece, in one place. Offers marked as codes are confirmed at checkout.</p><div class="pdp-tiles" data-mount></div></div>
</section>
{%- assign sim_n = 0 -%}
<section class="pdp-sec pdp-sec--ivory" id="similar"  data-pdp-hs data-header-light><div class="container"><div class="pdp-sechead"><h2 class="pdp-h2">Similar items</h2></div><div class="pdp-hswrap"><button type="button" class="pdp-hsbtn pdp-hsbtn--prev" data-hs-prev aria-label="Previous items">&#8249;</button><div class="pdp-hs" data-hs tabindex="0" aria-label="Similar items">{%- for p in pair_source -%}{%- if p.id != product.id and sim_n < 10 -%}{%- assign sim_n = sim_n | plus: 1 -%}<div class="pdp-hs__i">{% render 'shop-card', product: p %}</div>{%- endif -%}{%- endfor -%}</div><button type="button" class="pdp-hsbtn pdp-hsbtn--next" data-hs-next aria-label="Next items">&#8250;</button></div></div></section>

{%- assign more_n = 0 -%}
<section class="pdp-sec pdp-sec--ivory" id="more"  data-pdp-hs data-header-light><div class="container"><div class="pdp-sechead"><h2 class="pdp-h2">More from Drop 01</h2></div><div class="pdp-hswrap"><button type="button" class="pdp-hsbtn pdp-hsbtn--prev" data-hs-prev aria-label="Previous items">&#8249;</button><div class="pdp-hs" data-hs tabindex="0" aria-label="More from Drop 01">{%- for p in collections.all.products reversed -%}{%- if p.id != product.id and more_n < 10 -%}{%- assign more_n = more_n | plus: 1 -%}<div class="pdp-hs__i">{% render 'shop-card', product: p %}</div>{%- endif -%}{%- endfor -%}</div><button type="button" class="pdp-hsbtn pdp-hsbtn--next" data-hs-next aria-label="Next items">&#8250;</button></div></div></section>

<section class="pdp-sec pdp-sec--black pdp-rv" id="reviews" data-rv  {% if section.settings.review_url != blank %}data-write-url="{{ section.settings.review_url }}"{% endif %} data-pid="{{ product.id }}">
  <div class="container">
    <h2 class="pdp-h2">Ratings &amp; Reviews</h2>
    <p class="rv__dev" data-rv-dev hidden>Development sample data &mdash; not real customer reviews. Connect your review system to show genuine reviews here.</p>
    <script type="application/json" data-rv-data>{{ product.metafields.custom.reviews_json.value | json }}</script>
    <div class="rv__top">
      <div class="rv__sum">
        <div class="rv__sumhead"><b data-rv-total>No ratings yet</b><button type="button" class="rv__write" data-rv-write hidden>Write a Review</button></div>
        <span class="pdp-stars rv__stars" data-rv-stars aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <div class="rv__bars" data-rv-bars role="group" aria-label="Filter reviews by rating"></div>
      </div>
      <div class="rv__scales" data-rv-scales hidden></div>
    </div>
    <form class="rv__form" data-rv-form hidden>
      <h3>Write a Review</h3>
      <label>Rating<select name="rating"><option value="5">5 &#9733; Excellent</option><option value="4">4 &#9733; Good</option><option value="3">3 &#9733; Average</option><option value="2">2 &#9733; Poor</option><option value="1">1 &#9733; Terrible</option></select></label>
      <label>Title<input name="title" required maxlength="80" placeholder="Sum it up in a few words"></label>
      <label>Review<textarea name="body" required rows="4" maxlength="800" placeholder="What did you like or dislike?"></textarea></label>
      <label>Name<input name="name" required maxlength="40" placeholder="Your name"></label>
      <div class="rv__formbtns"><button type="submit" class="rv__submit">Submit review</button><button type="button" class="rv__cancel" data-rv-cancel>Cancel</button></div>
    </form>
    <div class="rv__attrs" data-rv-attrs hidden><h3>Frequently Mentioned</h3><div class="rv__chips" data-rv-chips></div></div>
    <div class="rv__tools" data-rv-tools hidden>
      <h3 data-rv-count></h3>
      <div class="rv__selects">
        <label class="rv__sel"><span>Sort by</span><select data-rv-sort><option value="recent">Newest</option><option value="helpful">Most helpful</option><option value="high">Highest rated</option><option value="low">Lowest rated</option></select></label>
        <label class="rv__sel"><span>Filter by</span><select data-rv-filter><option value="all">All Reviews</option><option value="5">5 Stars</option><option value="4">4 Stars</option><option value="3">3 Stars</option><option value="2">2 Stars</option><option value="1">1 Star</option><option value="verified">Verified buyers</option></select></label>
      </div>
    </div>
    <div class="rv__list" data-rv-list aria-live="polite"></div>
    <button type="button" class="rv__more" data-rv-more hidden>Read Reviews</button>
    <div class="rv__empty" data-rv-empty hidden><h3>No reviews yet</h3><p>Reviews appear here once customers have shared their thoughts.</p></div>
  </div>
</section>

<section class="pdp-sec pdp-sec--ivory" id="recent" data-pdp-recent data-pdp-hs data-header-light hidden><div class="container"><div class="pdp-sechead"><h2 class="pdp-h2">Recently viewed</h2><button type="button" class="pdp-edit" data-recent-edit>Edit</button></div><div class="pdp-hswrap"><button type="button" class="pdp-hsbtn pdp-hsbtn--prev" data-hs-prev aria-label="Previous items">&#8249;</button><div class="pdp-hs" data-hs data-recent-mount tabindex="0" aria-label="Recently viewed"></div><button type="button" class="pdp-hsbtn pdp-hsbtn--next" data-hs-next aria-label="Next items">&#8250;</button></div></div></section>

<div class="pdp-bar" data-bar aria-label="Quick purchase">
  {%- if first_img -%}<img src="{{ first_img | image_url: width: 120 }}" alt="" width="88" height="110">{%- endif -%}
  <div class="pdp-bar__i"><b data-bar-price>{{ current.price | money }}</b><span class="pdp-save" data-bar-save hidden></span><span><span data-bar-name>{{ product.title }}</span> <span data-bar-size></span></span></div>
  <button class="btn btn--red" type="button" data-bar-add><span>{{ 'products.add_to_bag' | t }}</span></button>
</div>

<script src="{{ 'pdp.js' | asset_url }}" defer></script>
<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "url", "id": "review_url", "label": "Write-a-review link", "info": "Your review app's form. Empty hides the Write a review button." },
    { "type": "textarea", "id": "details_fallback", "label": "Default details", "default": "Boxy fit, true to size. Men and unisex. Each piece is finished by hand, so small differences are part of the cloth." },
    { "type": "textarea", "id": "fabric_fallback", "label": "Default fabric & care", "default": "100% cotton. Cold wash inside out, line dry in shade, do not tumble. Frayed and patchwork pieces soften and loosen with wear — that is the point." },
    { "type": "header", "content": "Extra coupon (leave code blank to hide)" },
    { "type": "text", "id": "coupon_code", "label": "Coupon code", "info": "Must exist as a discount code in Shopify. The page carries it to checkout; Shopify validates it there." },
    { "type": "range", "id": "coupon_pct", "label": "Coupon discount shown (%)", "min": 0, "max": 50, "step": 1, "default": 0 },
    { "type": "range", "id": "coupon_min", "label": "Minimum order for coupon (₹)", "min": 0, "max": 20000, "step": 500, "default": 0 },
    { "type": "checkbox", "id": "coupon_stacks", "label": "Coupon combines with set savings", "default": false, "info": "Must match your Shopify combination rules. Off = the better offer is shown." },
    { "type": "header", "content": "Prepaid benefit" },
    { "type": "range", "id": "prepaid_pct", "label": "Extra % off online payment", "min": 0, "max": 20, "step": 1, "default": 0, "info": "0 hides it. Needs a matching payment-method discount in Shopify." },
    { "type": "header", "content": "Sets (shown savings)" },
    { "type": "range", "id": "duo_pct", "label": "Duo set saving (%)", "min": 0, "max": 40, "step": 1, "default": 0, "info": "Needs a matching automatic bundle discount in Shopify." },
    { "type": "range", "id": "trio_pct", "label": "Signature set (3 pieces) saving (%)", "min": 0, "max": 40, "step": 1, "default": 0 },
    { "type": "collection", "id": "pair_collection", "label": "Pairing collection", "info": "Defaults to Shopify's product recommendations." },
    { "type": "header", "content": "Shipping" },
    { "type": "range", "id": "free_ship_min", "label": "Free shipping above (₹)", "min": 0, "max": 20000, "step": 500, "default": 0, "info": "0 = free shipping on every order." },
    { "type": "range", "id": "ship_flat", "label": "Shipping charge below threshold (₹)", "min": 0, "max": 500, "step": 10, "default": 0 }
  ]
}
{% endschema %}
