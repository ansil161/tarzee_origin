    { "type": "richtext", "id": "details_fallback", "label": "Details (fallback)", "info": "A product metafield custom.details overrides this per product.", "default": "<p>Fabric, fit and care details appear here.</p>" },
    { "type": "richtext", "id": "policy", "label": "Exchange policy", "default": "<p><strong>Returns</strong> – Accepted only for defective, damaged, incorrect, or undelivered products. Must be requested within 24 hours.</p><p><strong>Refunds</strong> – Approved returns get a store credit coupon code (valid 50 days).</p><p><strong>Exchanges</strong> – Exchanges are strictly allowed only for size-related issues. Product exchanges are not permitted under any circumstances.</p><p>If the requested size is out of stock, no store credit or alternative compensation will be provided.</p><p>Exchange requests must be raised within 24-48 hours of delivery.</p><p>Only a one-time exchange is allowed per order, subject to a ₹250 exchange fee.</p><p><strong>Important Notes</strong> – Exchanges depend on stock availability. If unavailable we won't be able to proceed with the exchange. No exchanges on sale items. Products sold in a Sale are final, and are not eligible for returns, refunds or exchange.</p>" }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "₹150 OFF" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Prepaid above ₹1049" },
        { "type": "text", "id": "code", "label": "Coupon code", "default": "UFOFF150FIRE" },
        { "type": "checkbox", "id": "auto", "label": "Auto applied", "default": true }
