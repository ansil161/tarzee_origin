        { "type": "offer", "settings": { "title": "₹300 OFF", "subtitle": "Prepaid above ₹2069", "code": "UFOFF300FIRE", "auto": true } },
        { "type": "offer", "settings": { "title": "₹550 OFF", "subtitle": "Prepaid above ₹3599", "code": "UFOFF550FIRE", "auto": true } },
        { "type": "offer", "settings": { "title": "₹850 OFF", "subtitle": "", "code": "UFOFF850FIRE", "auto": true } }
      ]
    }
  ]
