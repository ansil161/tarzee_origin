<section class="section section--light" data-header-light>
  <div class="container">
    <h1 class="t-display" data-split>{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter__form" style="max-width:640px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'general.search' | t }}">
      <button type="submit">{{ 'general.search' | t }}</button>
    </form>
    {%- if search.performed -%}
      <p class="t-label u-mt-6 t-ash">{% if search.results_count > 0 %}{{ 'search.results' | t: terms: search.terms }}{% else %}{{ 'search.no_results' | t: terms: search.terms }}{% endif %}</p>
      {%- paginate search.results by 12 -%}
        <div class="product-grid u-mt-4" data-stagger>
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- else -%}<a class="card" href="{{ item.url }}"><div class="card__info"><h3 class="card__title">{{ item.title }}</h3></div></a>{%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<div class="t-label u-center u-mt-6">{{ paginate | default_pagination }}</div>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
