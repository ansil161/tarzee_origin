{%- comment -%}
  "Social wall" — masonry of customer quotes and photos, red + dark quote cards.
  Modelled on the social wall / testimonial block of the reference site.
  Replace the placeholder quotes with real customer reviews in the theme editor.
{%- endcomment -%}
<section class="sw" data-header-light>
  <div class="sw__head">
    <h2 class="sw__title"><span class="sw__a">{{ section.settings.heading }}</span><em class="sw__b">{{ section.settings.lead }}</em></h2>
    <nav class="sw__links" aria-label="Social">
      {%- if section.settings.x_url != blank -%}<a href="{{ section.settings.x_url }}" target="_blank" rel="noopener">X</a>{%- endif -%}
      {%- if section.settings.fb_url != blank -%}<a href="{{ section.settings.fb_url }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
      {%- if section.settings.ig_url != blank -%}<a href="{{ section.settings.ig_url }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
    </nav>
  </div>
  <div class="sw__wall">
    {%- for block in section.blocks -%}
      {%- if block.type == 'quote' -%}
        <figure class="sw__card sw__card--{{ block.settings.style }}" {{ block.shopify_attributes }}>
          <blockquote>“{{ block.settings.text }}”</blockquote>
          <figcaption>
            <span>-{{ block.settings.handle }}</span>
            {%- if block.settings.link_url != blank -%}<a href="{{ block.settings.link_url }}" target="_blank" rel="noopener">{{ block.settings.link_text }}</a>{%- endif -%}
          </figcaption>
        </figure>
      {%- else -%}
        {%- liquid
          if block.settings.image != blank
            assign src = block.settings.image | image_url: width: 900
          else
            assign src = block.settings.asset | asset_url
          endif
        -%}
        <div class="sw__photo" {{ block.shopify_attributes }}><img src="{{ src }}" alt="" loading="lazy" width="600" height="800"></div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Social wall",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Social" },
    { "type": "text", "id": "lead", "label": "Italic word", "default": "wall" },
    { "type": "url", "id": "x_url", "label": "X link" },
    { "type": "url", "id": "fb_url", "label": "Facebook link" },
    { "type": "url", "id": "ig_url", "label": "Instagram link", "default": "https://www.instagram.com/theterzeeorigins/" }
  ],
  "blocks": [
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "textarea", "id": "text", "label": "Quote", "default": "The materials feel premium and the craftsmanship is excellent." },
      { "type": "text", "id": "handle", "label": "Handle", "default": "@customer" },
      { "type": "select", "id": "style", "label": "Style", "default": "red", "options": [ { "value": "red", "label": "Red" }, { "value": "dark", "label": "Dark, red outline" } ] },
      { "type": "text", "id": "link_text", "label": "Link text", "default": "View on Instagram" },
      { "type": "url", "id": "link_url", "label": "Link" }
    ] },
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "asset", "label": "Or theme asset filename", "default": "look-02-back-4x5.jpg" }
    ] }
  ],
  "presets": [ { "name": "Social wall" } ]
}
{% endschema %}
