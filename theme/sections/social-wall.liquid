{%- comment -%}
  Social wall — premium minimal. Editorial header, staggered grid of community photos and
  hairline quote cards (one ink-filled accent per row). Replace the placeholder quotes with real reviews.
{%- endcomment -%}
{%- capture ig_icon -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6"/></svg>{%- endcapture -%}
<section class="sw" data-header-light>
  <div class="sw__head">
    <div>
      <p class="sw__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="sw__title" data-split>{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.ig_url != blank -%}
      <a class="sw__follow" href="{{ section.settings.ig_url }}" target="_blank" rel="noopener">{{ section.settings.follow_text }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg></a>
    {%- endif -%}
  </div>
  <div class="sw__wall">
    {%- for block in section.blocks -%}
      {%- if block.type == 'quote' -%}
        <figure class="sw__card sw__card--{{ block.settings.style }}" {{ block.shopify_attributes }}>
          <span class="sw__mark" aria-hidden="true">“</span>
          <blockquote>{{ block.settings.text }}</blockquote>
          <figcaption>
            <span class="sw__stars" aria-label="5 out of 5">★★★★★</span>
            <span>{{ block.settings.handle }}</span>
            {%- if block.settings.link_url != blank -%}<a href="{{ block.settings.link_url }}" target="_blank" rel="noopener">{{ block.settings.link_text }}</a>{%- endif -%}
          </figcaption>
        </figure>
      {%- else -%}
        {%- liquid
          if block.settings.image != blank
            assign src = block.settings.image | image_url: width: 900
          else
            assign src = block.settings.asset | asset_url
          endif
        -%}
        <a class="sw__photo" href="{{ block.settings.link_url | default: section.settings.ig_url | default: '#' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          <img src="{{ src }}" alt="" loading="lazy" width="600" height="750">
          {%- if block.settings.handle != blank -%}<span class="sw__tag">{{ ig_icon }}{{ block.settings.handle }}</span>{%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Social wall",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Social" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn in the wild" },
    { "type": "text", "id": "follow_text", "label": "Follow button", "default": "Follow @theterzeeorigins" },
    { "type": "url", "id": "ig_url", "label": "Instagram link", "default": "https://www.instagram.com/theterzeeorigins/" }
  ],
  "blocks": [
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "textarea", "id": "text", "label": "Quote", "default": "The materials feel premium and the craftsmanship is excellent." },
      { "type": "text", "id": "handle", "label": "Name / handle", "default": "@customer" },
      { "type": "select", "id": "style", "label": "Style", "default": "light", "options": [ { "value": "light", "label": "Light, hairline" }, { "value": "ink", "label": "Ink (black)" } ] },
      { "type": "text", "id": "link_text", "label": "Link text", "default": "View on Instagram" },
      { "type": "url", "id": "link_url", "label": "Link" }
    ] },
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "asset", "label": "Or theme asset filename", "default": "look-02-back-4x5.jpg" },
      { "type": "text", "id": "handle", "label": "Hover tag", "default": "@theterzeeorigins" },
      { "type": "url", "id": "link_url", "label": "Link override" }
    ] }
  ],
  "presets": [ { "name": "Social wall" } ]
}
{% endschema %}
