<section class="story grain">
  <div class="story__bg">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="" loading="lazy" width="2000" height="1200">
    {%- else -%}
      <img src="{{ section.settings.asset | asset_url }}" alt="" loading="lazy" width="2000" height="1200">
    {%- endif -%}
  </div>
  <div class="jali" aria-hidden="true"></div>
  <div class="story__inner">
    <h2 class="story__title" data-split>{{ section.settings.heading }}</h2>
    <p class="story__text t-body-lg" data-reveal>{{ section.settings.text }}</p>
    <div data-reveal><a class="btn btn--paper" href="{{ section.settings.cta_url }}"><span>{{ section.settings.cta }}</span></a></div>
  </div>
</section>
{% schema %}
{
  "name": "Story (full bleed)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rooted in craft." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Terzee means tailor. Every piece begins as one black cloth — printed, stitched, patched and frayed by hand until it carries the mark of the maker. Limited runs, no two alike." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Discover our journey" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "asset", "label": "Or theme asset filename", "default": "look-02-back.jpg" }
  ],
  "presets": [ { "name": "Story (full bleed)" } ]
}
{% endschema %}
