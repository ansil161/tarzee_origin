{%- liquid
  assign col = collections[section.settings.collection]
  assign use_demo = false
  if col == blank or col.products_count == 0
    assign use_demo = true
  endif
  assign heading_id = 'pmarquee-' | append: section.id
-%}
<section class="pmarquee section--light{% if section.settings.overlap %} pmarquee--overlap{% endif %}" data-header-light>
  {%- if section.settings.heading != blank -%}
    <h2 class="pmarquee__heading pmarquee__heading--{{ section.settings.align }}" id="{{ heading_id }}">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="pmarquee__viewport{% if section.settings.pausable %} pmarquee__viewport--pausable{% endif %}"
       data-pmarquee data-speed="{{ section.settings.speed }}" data-direction="{{ section.settings.direction }}"
       role="region" {% if section.settings.heading != blank %}aria-labelledby="{{ heading_id }}"{% else %}aria-label="Products"{% endif %}>
    <div class="pmarquee__track">
      {%- for copy in (1..2) -%}
        <ul class="pmarquee__list"{% if copy > 1 %} aria-hidden="true"{% endif %}>
          {%- if use_demo -%}
            {%- for block in section.blocks limit: section.settings.limit -%}
              <li class="pmarquee__item" {{ block.shopify_attributes }}>
                <a class="pmarquee__link" href="{{ block.settings.url | default: '#' }}"{% if copy > 1 %} tabindex="-1"{% endif %}>
                  <img class="pmarquee__image" src="{{ block.settings.image | asset_url }}" alt="" width="600" height="731" loading="lazy">
                  <span class="visually-hidden">{{ block.settings.title }}</span>
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for product in col.products limit: section.settings.limit -%}
              <li class="pmarquee__item">
                <a class="pmarquee__link" href="{{ product.url }}"{% if copy > 1 %} tabindex="-1"{% endif %}>
                  {%- if product.featured_image != blank -%}
                    <img class="pmarquee__image" src="{{ product.featured_image | image_url: width: 400 }}" srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 800 }} 800w" sizes="(max-width: 900px) 24vw, 8vw" alt="" width="400" height="500" loading="lazy">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'pmarquee__image placeholder' }}
                  {%- endif -%}
                  <span class="visually-hidden">{{ product.title }}</span>
                </a>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Product marquee",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See our products:" },
    { "type": "select", "id": "align", "label": "Heading alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" } ] },
    { "type": "collection", "id": "collection", "label": "Collection (when empty, demo blocks below are shown)" },
    { "type": "range", "id": "limit", "min": 4, "max": 20, "step": 1, "default": 12, "label": "Products to show" },
    { "type": "range", "id": "speed", "min": 20, "max": 120, "step": 5, "default": 45, "label": "Speed (px per second)" },
    { "type": "select", "id": "direction", "label": "Direction", "default": "left", "options": [ { "value": "left", "label": "Right to left" }, { "value": "right", "label": "Left to right" } ] },
    { "type": "checkbox", "id": "pausable", "label": "Pause on hover", "default": true },
    { "type": "checkbox", "id": "overlap", "label": "Fade up into the hero above", "default": false }
  ],
  "max_blocks": 20,
  "blocks": [
    { "type": "demo", "name": "Demo piece (asset image)", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Lattice Zip Jacket" },
      { "type": "text", "id": "image", "label": "Asset filename", "default": "lattice-zip-jacket-cutout.png" },
      { "type": "url", "id": "url", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "Product marquee" } ]
}
{% endschema %}
