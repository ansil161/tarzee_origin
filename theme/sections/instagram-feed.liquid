{%- comment -%}
  Instagram strip — heading with handle, then an endlessly sliding row of rounded portrait posters.
  Every poster links to the Instagram profile. Images: upload per block, or use theme asset filenames.
{%- endcomment -%}
{%- liquid
  assign handle = section.settings.handle | remove: '@'
  assign profile = section.settings.profile_url | default: 'https://www.instagram.com/theterzeeorigins/'
-%}
<section class="ig" data-header-light>
  <div class="ig__head">
    <div>
      <h2 class="ig__title"><a href="{{ profile }}" target="_blank" rel="noopener">@{{ handle }}</a></h2>
      <p class="ig__sub">{{ section.settings.subtitle }}</p>
    </div>
  </div>
  <div class="ig__carousel" style="--ig-speed:{{ section.settings.speed }}s">
    <div class="ig__track">
      {%- for i in (1..2) -%}
        <div class="ig__group"{% if i == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- liquid
              if block.settings.image != blank
                assign src = block.settings.image | image_url: width: 600
              else
                assign src = block.settings.asset | asset_url
              endif
            -%}
            <a class="ig__post" href="{{ profile }}" target="_blank" rel="noopener" tabindex="{% if i == 2 %}-1{% else %}0{% endif %}" aria-label="Instagram @{{ handle }}" {{ block.shopify_attributes }}>
              <img src="{{ src }}" alt="" loading="lazy" width="492" height="614" draggable="false">
              <span class="ig__meta"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6"/></svg></span>
            </a>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Instagram strip",
  "settings": [
    { "type": "text", "id": "handle", "label": "Instagram handle", "default": "theterzeeorigins" },
    { "type": "url", "id": "profile_url", "label": "Profile link", "default": "https://www.instagram.com/theterzeeorigins/" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Follow the latest looks, moments and stories." },
    { "type": "range", "id": "speed", "label": "Loop duration (seconds)", "min": 20, "max": 120, "step": 5, "default": 40 }
  ],
  "blocks": [ { "type": "post", "name": "Post", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "asset", "label": "Or theme asset filename", "default": "look-01-bomber-4x5.jpg" }
  ] } ],
  "presets": [ { "name": "Instagram strip", "blocks": [
    { "type": "post", "settings": { "asset": "look-01-bomber-4x5.jpg" } },
    { "type": "post", "settings": { "asset": "look-02-back-4x5.jpg" } },
    { "type": "post", "settings": { "asset": "look-03-camp-shirt-4x5.jpg" } }
  ] } ]
}
{% endschema %}
