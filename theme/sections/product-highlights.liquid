{%- comment -%}
  Key Highlights — edge-to-edge photo slider under the product info.
  Uses the product's images AFTER the ones already shown in the gallery stack (so nothing repeats). Each image's ALT TEXT becomes the black caption label,
  so write short captions as alt text in the product media (e.g. "Wide leg silhouette").
{%- endcomment -%}
{%- assign idx = 0 -%}
{%- assign shown = 0 -%}
{%- capture figs -%}
  {%- for media in product.media -%}
    {%- if media.media_type == 'image' -%}
      {%- assign idx = idx | plus: 1 -%}
      {%- if idx > section.settings.skip and shown < section.settings.max_items -%}
        {%- assign shown = shown | plus: 1 -%}
        <figure class="pdh__item">
          <img src="{{ media | image_url: width: 800 }}" alt="{{ media.alt | default: product.title | escape }}" width="800" height="1000" loading="lazy">
          {%- if media.alt != blank and media.alt != product.title -%}<figcaption>{{ media.alt }}</figcaption>{%- endif -%}
        </figure>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
<section class="pdh">
  <h2 class="pdh__title">{{ section.settings.heading }}</h2>
  <div class="pdh__track" style="--n:{{ shown }}">{{ figs }}</div>
</section>
<style>
  .pdh{background:#fff;color:#000;font-family:inherit;padding:28px 0 8px}
  .pdh *{box-sizing:border-box}
  .pdh__title{margin:0 0 14px;text-align:center;font-family:inherit;font-size:22px;line-height:1.3;font-weight:600;letter-spacing:.06em;text-transform:none}
  .pdh__track{display:grid;grid-template-columns:1fr;gap:4px}
  .pdh__item{position:relative;margin:0;aspect-ratio:4/5;overflow:hidden;background:#f4f4f4}
  .pdh__item img{width:100%;height:100%;object-fit:cover;display:block}
  .pdh__item figcaption{position:absolute;right:0;bottom:0;max-width:100%;padding:3px 7px;background:#000;color:#fff;font-size:11px;line-height:1.4;letter-spacing:.5px;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  @media (min-width:700px){.pdh__track{grid-template-columns:repeat(var(--n,3),minmax(0,1fr))}}
</style>
{%- endif -%}

{% schema %}
{
  "name": "Product highlights",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Key Highlights" },
    { "type": "range", "id": "max_items", "label": "Images to show", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "skip", "label": "Skip the first N images", "min": 0, "max": 8, "step": 1, "default": 4, "info": "Keep this equal to \"Images in the stack\" in the product section so no image repeats." }
  ],
  "presets": [ { "name": "Product highlights" } ]
}
{% endschema %}
