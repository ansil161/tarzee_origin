<div class="gate grain">
  <video autoplay muted loop playsinline poster="{{ 'hero-triptych-poster.jpg' | asset_url }}"><source src="{{ 'hero-triptych-1920.mp4' | asset_url }}" type="video/mp4"></video>
  <div class="gate__inner">
    <img src="{{ 'wordmark-origins-white.png' | asset_url }}" alt="{{ shop.name }}" width="200" height="83">
    <h1>{{ section.settings.heading }}</h1>
    <p class="t-body" style="opacity:.8">{{ section.settings.text }}</p>
    {%- form 'storefront_password' -%}
      <input type="password" name="password" placeholder="{{ 'general.password_label' | t }}" aria-label="{{ 'general.password_label' | t }}" required>
      <button type="submit">{{ 'general.password_submit' | t }} →</button>
      {%- if form.errors -%}<p class="t-label-sm u-mt-2">{{ form.errors.messages['form'] }}</p>{%- endif -%}
    {%- endform -%}
    <p class="t-label-sm u-mt-6" style="opacity:.5">Drop 01 · AW26</p>
  </div>
</div>
{% schema %}
{
  "name": "Password gate",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The archive opens soon." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Drop 01 — AW26. One black cloth, cut and sewn by hand. Enter the password for early access." }
  ]
}
{% endschema %}
