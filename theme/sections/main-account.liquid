<section class="section section--light" data-header-light>
  <div class="container">
    <div class="section-head">
      <h1 class="t-display" data-split>{{ 'customer.account' | t }}</h1>
      <a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a>
    </div>
    <p class="t-body">{{ customer.first_name }} {{ customer.last_name }} · {{ customer.email }}</p>
    <h2 class="t-headline u-mt-6">{{ 'customer.orders' | t }}</h2>
    <ul class="u-mt-4" style="border-top:1px solid currentColor">
      {%- for order in customer.orders -%}
        <li style="display:flex;justify-content:space-between;padding:14px 0;border-bottom:1px solid currentColor"><a href="{{ order.customer_url }}">{{ order.name }}</a><span>{{ order.created_at | date: '%d %b %Y' }}</span><span>{{ order.total_price | money }}</span></li>
      {%- else -%}
        <li style="padding:14px 0" class="t-ash">No orders yet.</li>
      {%- endfor -%}
    </ul>
    <h2 class="t-headline u-mt-6">{{ 'customer.addresses' | t }}</h2>
    {%- if customer.default_address -%}<p class="t-body u-mt-2">{{ customer.default_address | format_address }}</p>{%- endif -%}
    <a class="link u-mt-2" href="{{ routes.account_addresses_url }}">Manage addresses</a>
  </div>
</section>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
