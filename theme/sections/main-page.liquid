<section class="section section--flush section--light" data-header-light>
  <div class="page-narrow">
    <div class="eyebrow t-label"><span class="dia"></span>{{ section.settings.eyebrow | default: 'Terzee Origins' }}</div>
    <h1 data-split>{{ page.title }}</h1>
    <div class="rte t-body-lg">{{ page.content }}</div>
  </div>
</section>
{% schema %}
{ "name": "Page", "settings": [ { "type": "text", "id": "eyebrow", "label": "Eyebrow" } ] }
{% endschema %}
