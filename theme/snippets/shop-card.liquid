{%- comment -%}
  Collection-page product card (layout copied from the reference catalog page):
  3:4 image tile · wishlist heart · "New" badge · second image fades in on hover ·
  colour swatches · title / category / colour / price.
  Accepts: product — or demo values: demo_title, demo_price, demo_meta, demo_image, demo_url, demo_tag
{%- endcomment -%}
{%- if product == blank -%}
<div class="shop-card" data-shop-card>
  <div class="shop-card__image-wrapper">
    <button type="button" class="shop-wishlist" data-wishlist="{{ demo_title | handle }}" aria-label="Add to wishlist" aria-pressed="false">
      <svg class="shop-heart" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
    </button>
    {%- if demo_tag != blank -%}<span class="shop-badge">{{ demo_tag }}</span>{%- endif -%}
    <a class="shop-card__image-link" href="{{ demo_url | default: '#' }}" draggable="false" tabindex="-1" aria-hidden="true"><img class="shop-card__img" src="{{ demo_image | asset_url }}" alt="{{ demo_title | escape }}" width="800" height="1000" loading="lazy" draggable="false"></a>
  </div>
  <div class="shop-card__info">
    <h3 class="shop-card__title"><a href="{{ demo_url | default: '#' }}">{{ demo_title }}</a></h3>
    <span class="shop-card__category">{{ demo_meta }}</span>
    <span class="shop-card__price">{{ demo_price }}</span>
  </div>
</div>
{%- else -%}
{%- liquid
  assign img = product.featured_image
  assign color_option = nil
  assign cidx = 0
  for opt in product.options_with_values
    assign n = opt.name | downcase
    if n == 'color' or n == 'colour'
      assign color_option = opt
      assign cidx = forloop.index0
    endif
  endfor
  assign badge = ''
  if product.available == false
    assign badge = 'products.sold_out' | t
  elsif product.tags contains 'limited'
    assign badge = 'products.limited' | t
  elsif product.tags contains 'new'
    assign badge = 'New'
  endif
-%}
<div class="shop-card" data-shop-card data-product-id="{{ product.id }}">
  <div class="shop-card__image-wrapper">
    <button type="button" class="shop-wishlist" data-wishlist="{{ product.id }}" aria-label="Add to wishlist" aria-pressed="false">
      <svg class="shop-heart" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
    </button>
    {%- if badge != blank -%}<span class="shop-badge">{{ badge }}</span>{%- endif -%}
    <a class="shop-card__image-link" href="{{ product.url }}" draggable="false" tabindex="-1" aria-hidden="true">
      {%- if img -%}
        <img class="shop-card__img" src="{{ img | image_url: width: 800 }}" srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w" sizes="(max-width:600px) 50vw, (max-width:900px) 45vw, (max-width:1280px) 25vw, 20vw" alt="{{ img.alt | default: product.title | escape }}" width="800" height="1000" loading="lazy" draggable="false">
        {%- comment -%}Hover image: first gallery image whose alt text says model / wearing / worn. No match = no hover image.{%- endcomment -%}{%- assign img2 = nil -%}{%- for im in product.images offset: 1 -%}{%- assign im_alt = im.alt | downcase -%}{%- if im_alt contains 'model' or im_alt contains 'wearing' or im_alt contains 'worn' -%}{%- assign img2 = im -%}{%- break -%}{%- endif -%}{%- endfor -%}
        {%- if img2 -%}
        <img class="shop-card__img shop-card__img--alt" src="{{ img2 | image_url: width: 800 }}" srcset="{{ img2 | image_url: width: 400 }} 400w, {{ img2 | image_url: width: 800 }} 800w" sizes="(max-width:600px) 50vw, (max-width:900px) 45vw, (max-width:1280px) 25vw, 20vw" alt="" width="800" height="1000" loading="lazy" draggable="false" data-shop-alt>
        {%- endif -%}
      {%- else -%}
        <div class="shop-card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </a>
  </div>
  {%- if color_option and color_option.values.size > 1 -%}
    <div class="shop-card__swatches" role="group" aria-label="{{ color_option.name }}">
      {%- for value in color_option.values -%}
        {%- liquid
          assign swatch_img = ''
          for variant in product.variants
            if variant.featured_image and swatch_img == ''
              assign c = variant.options[cidx]
              if c == value
                assign swatch_img = variant.featured_image | image_url: width: 800
              endif
            endif
          endfor
        -%}
        <button type="button" class="shop-swatch{% if forloop.first %} active{% endif %}" data-swatch="{{ value | escape }}" data-image="{{ swatch_img }}" style="background:{{ value | handle | replace: '-', '' }}" title="{{ value | escape }}" aria-label="{{ value | escape }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
  <div class="shop-card__info">
    <h3 class="shop-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if product.type != blank -%}<span class="shop-card__category">{{ product.type }}</span>{%- endif -%}
    <span class="shop-card__color" data-shop-color>{% if color_option %}{{ color_option.values.first }}{% elsif product.metafields.custom.technique != blank %}{{ product.metafields.custom.technique }}{% endif %}</span>
    <span class="shop-card__price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<s class="shop-card__compare">{{ product.compare_at_price | money }}</s>{% endif %}</span>
  </div>
</div>
{%- endif -%}
