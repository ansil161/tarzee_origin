{%- comment -%}
  Product card. Accepts: product (object) OR demo values:
  demo_title, demo_price, demo_meta, demo_image, demo_image_alt, demo_url, demo_tag
{%- endcomment -%}
{%- if product -%}
  {%- assign img1 = product.featured_image -%}
  {%- assign img2 = product.images[1] -%}
  <a class="card" href="{{ product.url }}" data-cursor="view">
    <div class="card__media">
      {%- if product.tags contains 'new' -%}<span class="card__tag">{{ 'products.new_drop' | t }}</span>{%- endif -%}
      {%- if product.tags contains 'limited' -%}<span class="card__tag">{{ 'products.limited' | t }}</span>{%- endif -%}
      {%- if img2 -%}
        <img class="alt" src="{{ img2 | image_url: width: 900 }}" alt="" loading="lazy" width="900" height="1125">
      {%- endif -%}
      {%- if img1 -%}
        <img class="main" src="{{ img1 | image_url: width: 900 }}" srcset="{{ img1 | image_url: width: 500 }} 500w, {{ img1 | image_url: width: 900 }} 900w, {{ img1 | image_url: width: 1200 }} 1200w" sizes="(max-width:700px) 50vw, 25vw" alt="{{ img1.alt | default: product.title | escape }}" loading="lazy" width="900" height="1125">
      {%- endif -%}
      {%- unless product.has_only_default_variant == false -%}
      <div class="card__quick">
        <form method="post" action="{{ routes.cart_add_url }}" data-ajax-cart>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button class="btn" type="submit"{% unless product.available %} disabled{% endunless %}><span>{% if product.available %}{{ 'products.add_to_bag' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span></button>
        </form>
      </div>
      {%- else -%}
      <div class="card__quick"><span class="btn"><span>{{ 'products.view' | t }}</span></span></div>
      {%- endunless -%}
    </div>
    <div class="card__info">
      <div>
        <h3 class="card__title">{{ product.title }}</h3>
        <div class="card__meta">{{ product.type }}{% if product.metafields.custom.technique %} · {{ product.metafields.custom.technique }}{% endif %}</div>
      </div>
      <div class="card__price">
        {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
        {{ product.price | money }}
      </div>
    </div>
  </a>
{%- else -%}
  <a class="card" href="{{ demo_url | default: '#' }}" data-cursor="view">
    <div class="card__media">
      {%- if demo_tag != blank -%}<span class="card__tag">{{ demo_tag }}</span>{%- endif -%}
      {%- if demo_image_alt != blank -%}<img class="alt" src="{{ demo_image_alt | asset_url }}" alt="" loading="lazy" width="900" height="1125">{%- endif -%}
      <img class="main" src="{{ demo_image | asset_url }}" alt="{{ demo_title | escape }}" loading="lazy" width="900" height="1125">
      <div class="card__quick"><span class="btn"><span>{{ 'products.view' | t }}</span></span></div>
    </div>
    <div class="card__info">
      <div>
        <h3 class="card__title">{{ demo_title }}</h3>
        <div class="card__meta">{{ demo_meta }}</div>
      </div>
      <div class="card__price">{{ demo_price }}</div>
    </div>
  </a>
{%- endif -%}
